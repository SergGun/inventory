// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product{
  id          String   @id @default(cuid()) @map("PID")
  userId      String   @map("PUserID")

  name        String   @map("PName")
  description String?  @map("PDescription")

  sku         String?  @unique @map("PSku")
  price       Decimal  @db.Decimal(12, 2) @map("PPrice")
  quantity    Int      @default(0) @map("PQuantity")
  lowStock    Int?     @map("PLowStock")

  createdAt   DateTime @default(now()) @map("PCreatedAt")
  updatedAt   DateTime @updatedAt @map("PUpdatedAt")

  @@index([userId, name])
  @@index([createdAt])

  @@map("Product")
}